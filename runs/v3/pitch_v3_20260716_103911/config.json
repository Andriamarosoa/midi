{
  "data": {
    "npz": "data/processed/stream/00_BN1-129-Eb_comp_hex.npz",
    "min_pitch": 40,
    "max_pitch": 88,
    "validation_ratio": 0.2,
    "seed": 42,
    "normalization_percentile": 99.0,
    "normalization_target": 0.9,
    "max_gain": 20.0
  },
  "sampler": {
    "enabled": true,
    "balance_strength": 0.35,
    "max_class_multiplier": 1.5,
    "epoch_multiplier": 1.0
  },
  "model": {
    "input_samples": 4096,
    "channels": 32,
    "tcn_blocks": 4,
    "dense_units": 128,
    "dropout": 0.2,
    "pooling": "hybrid"
  },
  "train": {
    "output_root": "runs/v3",
    "run_name": "pitch_v3",
    "batch_size": 32,
    "epochs": 60,
    "learning_rate": 0.001,
    "early_stopping_patience": 7,
    "reduce_lr_patience": 3,
    "min_learning_rate": 1e-06
  },
  "evaluation": {
    "top_k": 3,
    "make_plots": true
  }
}