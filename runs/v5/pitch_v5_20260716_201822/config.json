{
  "dataset": {
    "manifest": "data\\processed\\stream\\manifest.csv",
    "min_pitch": 40,
    "max_pitch": 88,
    "train_players": [
      "00",
      "01",
      "02",
      "03"
    ],
    "validation_players": [
      "04"
    ],
    "test_players": [
      "05"
    ],
    "seed": 42,
    "sample_rate": 44100,
    "hop_size": 256,
    "max_window": 4096,
    "normalization_percentile": 95.0,
    "normalization_target": 0.8,
    "max_gain": 16.0
  },
  "cache": {
    "mode": "ram",
    "validate_schema": true
  },
  "train": {
    "run_name": "pitch_v5",
    "output_root": "runs\\v5",
    "batch_size": 32,
    "epochs": 1,
    "learning_rate": 0.001,
    "early_stopping_patience": 6,
    "reduce_lr_patience": 3,
    "min_learning_rate": 1e-06,
    "workers": 1
  },
  "model": {
    "channels": 32,
    "tcn_blocks": 4,
    "dropout": 0.1,
    "dense_units": 128,
    "pooling": "hybrid"
  },
  "evaluation": {
    "make_plots": true,
    "save_predictions": false
  }
}