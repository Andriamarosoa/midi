  "scientific_question": "Can a vectorized support-normalized pitch-dilution trajectory derived from one shared causal spectrum, when combined with strictly causal 4096-sample and 8192-sample evidence ending at the same hop, distinguish an identifiable new fundamental from a lingering harmonic without claiming to resolve exactly coincident non-identifiable sources?",
  "hypotheses": {
    "primary": "After removing pitch/support geometry and gain, the joint dilution-residual and causal-birth representation differs between old-source harmonic persistence and an independently attacked new fundamental whenever independent onset or own-harmonic evidence exists.",
    "null_transform_only": "Applying deterministic pitch scaling or its equivalent relative spectral censor to the whole mixture preserves exact frequency collisions and provides no source attribution by itself.",
    "null_geometry": "The raw transform index at which a component leaves support is determined by pitch and observation limits and is not an admissible discriminative feature.",
    "non_identifiability": "Two latent explanations that produce byte-identical causal samples and identical allowed state must yield identical features and AMBIGUOUS.",
    "long_context_role": "The 8192-sample view may confirm persistence or decay of evidence observed in the 4096-sample view, but it may not use future samples, introduce a second onset decision, or override exact non-identifiability.",
    "falsifiable_positive_condition": "On every preregistered identifiable positive fixture, the independent new fundamental must be supported after one causal hop; on every preregistered harmonic-only negative fixture no new fundamental may be supported; every preregistered exact collision must remain AMBIGUOUS."
  },
  "non_objectives": [
    "claiming_that_repeated_pitch_transposition_alone_separates_coincident_sources",
    "using_a_raw_disappearance_or_survival_index_as_a_feature",
    "running_30_to_50_model_inferences_per_candidate",
    "waveform_subtraction_without_phase_or_source_identity",
    "exclusive_ownership_of_shared_partials",
    "inferring_string_or_fret_identity",
    "training_fitting_or_calibrating_any_model",
    "opening_real_audio_labels_H17_or_locked_test",
    "emitting_MIDI_from_analytical_observation_coordinates"
  ],
