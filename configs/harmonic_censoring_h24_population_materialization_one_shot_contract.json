    "algorithm_id": "H24_WAVEFORM_ALGORITHM_V1",
    "definition_status": "normative_future_materializer_contract_not_implemented",
    "sample_rate_hz": 44100,
    "sample_count": 12544,
    "hop_samples": 256,
    "analysis_window_samples": 4096,
    "array_dtype_during_synthesis": "numpy.float64",
    "seed_rule": "unsigned_little_endian_uint64(first_8_bytes(SHA256(UTF8('H24|'+fixture_id))))",
