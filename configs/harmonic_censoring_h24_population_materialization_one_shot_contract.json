    "OOD_semantics": {
      "impulse": "all zero except x[12032]=0.4",
      "linear_chirp": "zero outside 8192..12287; n=g-8192; 0.4*sin(2*pi*(80*n/44100+0.5*(8000-80)*(n/44100)^2/(4095/44100)))",
      "log_chirp": "zero outside 8192..12287; f[n]=80*100^(n/4095); phase=2*pi*cumsum(f)/44100; amplitude 0.4",
      "nonharmonic_stack": "zero outside 8192..12287; sum 0.08*sin(2*pi*f*n/44100) for f=[233,377,611,997,1597]",
