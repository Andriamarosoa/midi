        "slide_mild": {"trajectory": "linear_semitones", "start": 0, "end": 2, "duration_hops": 4},
        "slide_wide": {"trajectory": "linear_semitones", "start": 0, "end": 12, "duration_hops": 4},
        "slide_fast": {"trajectory": "linear_semitones", "start": 0, "end": 7, "duration_hops": 2},
        "slide_slow": {"trajectory": "linear_semitones", "start": 0, "end": 7, "duration_hops": 8},
        "vibrato_mild": {"trajectory": "sinusoidal_cents", "depth": 25, "rate_hz": 5},
        "vibrato_wide": {"trajectory": "sinusoidal_cents", "depth": 100, "rate_hz": 5},
        "vibrato_fast": {"trajectory": "sinusoidal_cents", "depth": 50, "rate_hz": 8},
        "vibrato_slow": {"trajectory": "sinusoidal_cents", "depth": 50, "rate_hz": 3}
