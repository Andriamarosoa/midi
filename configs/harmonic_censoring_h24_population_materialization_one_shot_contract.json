    "source_harmonic_amplitude": "gain*(0.4/harmonic), additionally multiplied by fundamental_amplitude only for harmonic=1",
    "source_phase": "2*pi*cumsum(frequency,float64)/44100; subtract first phase; add h1_phase for H1 and phase for H2+",
    "old_envelope": "0 before sample 4096; exp(-((g-4096)+old_source_age_hops*256)/8192) otherwise",
    "new_envelope": "0 before onset default 12032; min(1,(elapsed+1)/max(1,attack_hops*256+1))*exp(-elapsed/(decay_tau_hops*256)) otherwise; defaults attack_hops=0 decay_tau_hops=8",
    "second_distinct_envelope": "0 before 12160; min(1,(elapsed+1)/32)*exp(-elapsed/1024) otherwise",
    "technique_trajectories": {
      "linear_cents": "linear start-to-end over duration_hops*256 then hold, divided by 100 to semitones",
      "linear_semitones": "linear start-to-end over duration_hops*256 then hold",
      "sinusoidal_cents": "depth/100*sin(2*pi*rate_hz*max(g-onset,0)/44100)"
    },
    "base_S5": "old envelope times 0.1*sin(2*pi*(4*440*2^((40-69)/12))*g/44100)",
    "variant_dispatch_order": [
      "amplitude_gain",
      "relative_phase_radians",
      "envelope_attack_decay_hops",
      "cents_inharmonicity",
      "noise",
      "neighbour_semitones",
      "interval_semitones",
      "chord_spec",
      "physical_unison",
      "technique",
      "natural_harmonic",
      "sympathetic_resonance",
      "old_source_age_hops",
      "event_sample_offset",
      "pitch_boundary",
      "silence",
      "synthetic_OOD"
    ],
    "variant_semantics": {
      "amplitude_gain": "set gain=value on every source",
      "relative_phase_radians": "set H2+ phase=value on every source",
      "envelope_attack_decay_hops": "set attack_hops=attack and decay_tau_hops=decay_tau on every new source",
      "cents_inharmonicity": "set cents and inharmonicity_B=B on every source",
      "noise": "after clean synthesis add unit-RMS white or pink noise at clean_rms/10^(snr_db/20); PCG64 seed is fixture seed",
      "neighbour_semitones": "clone the new source, shift pitch by value and append",
      "interval_semitones": "clone first source, shift pitch by value, set harmonics=[1,2,3,4] and append",
      "chord_spec": "replace sources by new-envelope pitches 64+offset with harmonics [1,2,3,4], using exact named offsets",
      "physical_unison": "append clone of first source using exact named gain/phase and optional second_distinct envelope",
      "technique": "attach the exact named trajectory to every source",
      "natural_harmonic": "replace first-source harmonics and fundamental_amplitude with exact named values",
      "sympathetic_resonance": "append pitch 64 H1 old-envelope source at exact named relative gain",
      "old_source_age_hops": "set age on every old source",
      "event_sample_offset": "set every new-source onset to 8192+value",
      "pitch_boundary": "for values 40 or 76 set every new-source pitch; analytical_128 leaves waveform sources unchanged",
      "silence": "replace all 12544 samples by +0.0",
      "synthetic_OOD": "replace waveform by the exact named OOD construction"
    },
    "named_values_source": "historical derivation note only: closed numeric values were copied into named_values_required; the future H24 materializer must use only this contract and the H24 recipe and must not read the H23 contract at runtime; no H23 seed, waveform, ID, target outcome or execution result is inherited",
    "named_values_required": {
      "chord_spec": {
        "major_triad": [0, 4, 7],
        "minor_triad": [0, 3, 7],
        "sus4": [0, 5, 7],
        "dense_four_note": [0, 4, 7, 11]
      },
