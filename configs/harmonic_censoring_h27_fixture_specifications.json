    },
    "clean_then_noise": "finish every source accumulation first; then add declared noise sample-by-sample in ascending g; NONE consumes no RNG",
    "white_noise_v1": "PCG64(exact uint64 seed), standard_normal(16640) float64; exact +0.0 outside support; on support subtract ascending-order float64 mean, divide by ascending-order float64 RMS, multiply by clean-support RMS*10^(-snr_db/20), then add in ascending g",
    "empty_sources": "waveform remains exact positive float64 zero; causal history and masks never synthesize hidden audio",
    "vectorized_reduction_substitution_forbidden": true,
    "masks_applied_after_waveform_generation": true,
    "hidden_audio_forbidden": true,
