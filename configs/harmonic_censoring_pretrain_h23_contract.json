{
  "schema_version": 1,
  "purpose": "harmonic_censoring_multiscale_pretrain_h23_contract",
  "status": "pretrain_test_plan_defined_external_review_required",
  "scope": {
    "contract_only": true,
    "implementation_authorized": false,
    "synthetic_execution_authorized": false,
    "scientific_execution_authorized": false,
    "real_data_access_authorized": false,
    "training_authorized": false,
    "fit_performed": false,
    "calibration_performed": false,
    "h17_population_used": false,
    "locked_test_used": false
  },
  "scientific_question": "Can a causal multiscale harmonic-censoring representation provide non-trivial evidence for fundamental attribution, source birth, harmonic false-note rejection and source cardinality after removing pitch/cutoff geometry and global-energy effects?",
  "hypotheses": {
    "primary": "A shared causal spectral representation observed through relative low-pass censoring contains residual structural information beyond candidate pitch and total energy.",
    "source_birth": "A new source is supported by a causal combination of onset, harmonic novelty, new energy and unexplained residual after accounting for older sources.",
    "factorization": "Global comparison of K versus K+1 sources with shared partials is safer than exclusive partial ownership or independent pitch decisions.",
    "non_identifiability": "Exactly coincident contributions without independent onset, envelope or harmonic evidence are not identifiable and must produce AMBIGUOUS."
  },
  "non_objectives": [
    "training_or_fitting_any_model",
    "threshold_selection_or_probability_calibration",
    "opening_real_audio_or_scientific_labels",
    "reusing_the_consumed_H17_population",
    "using_locked_test_assets",
    "emitting_MIDI_outside_40_76",
    "solving_exactly_non_identifiable_mixtures",
    "waveform_subtraction_without_phase",
    "hard_string_or_fret_ownership",
    "running_30_to_50_live_pitch_shift_inferences"
  ],
  "product_contract": {
    "sample_rate_hz": 44100,
    "hop_samples": 256,
    "causal_window_samples": 4096,
    "future_lookahead_samples": 0,
    "physical_midi_output_min": 40,
    "physical_midi_output_max": 76,
    "virtual_observation_pitch_min": 40,
    "virtual_observation_pitch_max_inclusive": 127,
    "virtual_pitch_count": 88,
    "harmonics_per_candidate": 20,
    "live_cutoff_count_allowed": [4, 6],
    "offline_teacher_cutoff_count_allowed": [16, 32]
  },
  "mathematical_contract": {
    "shared_representation": "one causal spectrum or log-frequency representation per frame",
    "candidate_axis": "MIDI pitch p",
    "censoring_axis": "relative cutoff c expressed as cutoff_over_F0 or harmonic rank h_c",
    "raw_evidence": "S_raw(p,c): candidate evidence after applying relative censoring without energy renormalization",
    "normalized_evidence": "S_norm(p,c): same evidence after preregistered energy normalization",
    "geometric_null": "S_null(p,c): expected curve caused only by candidate pitch and cutoff geometry",
    "residual_evidence": "S_residual(p,c)=S(p,c)-S_null(p,c)",
    "primary_representation": "pitch_by_censoring_matrix",
    "summaries_are_secondary": [
      "AUC_raw",
      "AUC_normalized",
      "k90",
      "k50",
      "k10",
      "maximum_slope_and_location",
      "positive_rebound",
      "roughness",
      "regime_changes",
      "curvature",
      "final_residual"
    ],
    "forbidden_primary_representation": "single_disappearance_index",
    "oriented_harmonic_graph": "F0_to_h_times_F0_for_h_greater_or_equal_to_1_only",
    "shared_partials_allowed": true,
    "exclusive_partial_ownership_forbidden": true,
    "candidate_order_must_not_change_result": true,
    "graph_traversal_order_must_not_change_result": true
  },
  "feature_schema_contract": {
    "feature_sources_allowed": [
      "current_and_past_audio_within_the_4096_sample_causal_window",
      "candidate_pitch_hypothesis",
      "relative_censoring_masks",
      "independent_spectral_observation",
      "causally_available_onset_and_envelope_evidence",
      "causally_available_old_source_state"
    ],
    "three_channels_must_remain_separate": [
      "F0_hypothesis",
      "conditional_harmonic_head_prediction",
      "independent_signal_derived_spectral_observation"
    ],
    "forbidden_features": [
      "target",
      "future_audio",
      "future_labels",
      "reference_note_identity",
      "dataset_split_encoded_as_signal",
      "post_decision_decoder_state",
      "post_emission_rank_or_selection",
      "ground_truth_string_or_fret",
      "H17_outcome_or_population_membership"
    ],
    "validity_masks_required": [
      "candidate_pitch_valid",
      "cutoff_valid",
      "frequency_support_valid",
      "causal_window_valid",
      "onset_evidence_available",
      "old_source_context_available",
      "virtual_observation_only"
    ],
    "targets_are_not_features": true,
    "unidentifiable_target": "AMBIGUOUS",
    "missing_or_invalid_is_not_negative": true,
    "provenance_required": [
      "contract_sha256",
      "fixture_id",
      "synthesis_seed",
      "sample_rate",
      "hop_samples",
      "window_samples",
      "cutoff_definition",
      "feature_schema_sha256",
      "code_commit",
      "real_data_used",
      "h17_population_used",
      "locked_test_used",
      "fit_performed"
    ]
  },
  "synthetic_fixture_contract": {
    "base_cases": {
      "S1C": "conceptual C2 with H2 H3 H4 H5 decaying; one source; C3/C4 explained; no source birth",
      "S1P": "physically representable MIDI40 analogue of S1C preserving harmonic ratios",
      "S2": "true C4 with its H2 H3 H4 attacked at t0; C4 required; source birth present",
      "S3": "old decaying C2 around t0 and nothing new; no source birth",
      "S4": "old decaying C2 plus new true C4; shared C4 frequency is old H4 and new H1; two-source explanation preferred",
      "S5": "same shared frequency without independent onset, harmonics or envelope; exact AMBIGUOUS required"
    },
    "variant_axes": [
      "amplitude",
      "relative_phase",
      "attack_and_decay_envelopes",
      "inharmonicity_and_cents_offset",
      "noise_level_and_colour",
      "neighbouring_semitones",
      "octaves_and_fifths",
      "dyads_and_dense_chords",
      "physical_unisons",
      "bends_slides_vibrato",
      "natural_harmonics",
      "sympathetic_resonance",
      "age_of_old_source_at_t0",
      "window_boundary_position",
      "pitches_40_76_and_virtual_127",
      "silence",
      "synthetic_OOD"
    ],
    "deterministic_synthesis_only": true,
    "real_recordings_forbidden": true,
    "basic_pitch_as_oracle_forbidden": true
  },
  "test_record_schema": [
    "id",
    "phase",
    "objective",
    "exact_input",
    "procedure",
    "oracle",
    "metrics",
    "pass_rule",
    "fail_rule",
    "artifacts",
    "drawback",
    "inverse_check"
  ],
  "test_record_resolution": {
    "rule": "Every catalogue entry inherits every missing field below; an explicit per-test field overrides the inherited value.",
    "phase_resolution": "The phase field is the enclosing test_catalogue key for that entry.",
    "inherited_defaults": {
      "metrics": [
        "oracle_value_or_category",
        "pass_rule_boolean",
        "validity_mask_counts",
        "nonfinite_count",
        "inverse_check_boolean"
      ],
      "fail_rule": "Any violation of the explicit oracle/pass_rule, any nonfinite unmasked value, any missing required artifact, or a passing inverse control is FAIL.",
      "artifacts": [
        "resolved_test_contract.json",
        "input_fixture_spec.json",
        "observed_values.json",
        "oracle_comparison.json",
        "inverse_check.json",
        "sha256_manifest.json"
      ],
      "drawback": "Record the strongest alternative explanation, any dependence on pitch/gain/filter/window geometry, and whether the test can only demonstrate a necessary rather than sufficient condition."
    },
    "resolved_record_must_contain_every_test_record_schema_field": true
  },
